# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# Preview mode
# ---------------------------------------------------------------------------
# true  = the whole UI runs on fixture data, no Supabase needed. Every write is
#         refused with "Preview mode is read-only", /login is bypassed, and the
#         "Preview as Admin/Member/Client" switcher appears in the top bar.
# false = the real thing. The switcher disappears on its own; there is nothing
#         to remember to delete.
PREVIEW_MODE=true

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, and it bypasses every RLS policy. It is read by the invite flows
# and scripts/create-admin.mjs. Never prefix it with NEXT_PUBLIC_ — that would
# ship it to the browser and hand every visitor full database access.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# supabase keeps attachments in a private Supabase Storage bucket. Recommended
# for anything deployed: a file outlives the deploy that follows it, and it
# needs no persistent disk of its own. Requires migration 0030 to have been run
# so the bucket exists, and reuses SUPABASE_SERVICE_ROLE_KEY above.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=attachments

# local writes under STORAGE_ROOT instead, which is the right choice for
# development. On a server it is only safe with a persistent disk mounted
# OUTSIDE the checkout — the default below sits inside the repo, where the next
# deploy replaces it and every attachment goes with it.
# STORAGE_PROVIDER=local
# STORAGE_ROOT=./storage

# Existing files are unaffected by changing this. Each row records the provider
# it was written with, so old and new can coexist and nothing needs migrating.

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# console prints the message to the server log instead of sending — the right
# setting until a domain is verified. Switch to resend to actually send, which
# also needs RESEND_API_KEY and EMAIL_FROM.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="Tasker <invoices@yourdomain.com>"

# Used to build absolute links in emails and invoices.
APP_URL=http://localhost:3000
